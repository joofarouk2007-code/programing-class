%% Part 1a: Plot f(x,y) = 1 - 2x^2 - 3y^2
x = -2:0.1:1;
y = -2:0.1:1;
[X, Y] = meshgrid(x, y);

Z = 1 - 2*X.^2 - 3*Y.^2;

figure
surf(X, Y, Z)
shading interp
colormap(jet)
view(70, 70)

xlabel('x axis')
ylabel('y axis')
zlabel('z axis')
title('Surface plot of f(x,y) = 1 - 2x^2 - 3y^2')
grid on

%% Setup for Complementary Task: z(x,y) = 1 - (x^2 + y^2)
xp = -2:0.1:2;
yp = -2:0.1:2;
[Xp, Yp] = meshgrid(xp, yp);
Zp = 1 - (Xp.^2 + Yp.^2);

%% Part Pa: surf with camlight effect
figure
surf(Xp, Yp, Zp)
shading interp
colormap("winter")
camlight
lighting gouraud

xlabel('x axis')
ylabel('y axis')
zlabel('z axis')
title('Surface with camlight effect')
grid on

%% Part Pb: surf with contour
figure
surf(Xp, Yp, Zp)
shading interp
colormap("parula")
hold on
contour(Xp, Yp, Zp, 20, 'k')

xlabel('x axis')
ylabel('y axis')
zlabel('z axis')
title('Surface with contour lines')
grid on

%% Part Pc: semitransparent surface
figure
surf(Xp, Yp, Zp)
shading interp
colormap(cool)
alpha(0.5)

xlabel('x axis')
ylabel('y axis')
zlabel('z axis')
title('Semitransparent surface')
grid on

